# ============================================================
# AI Kiosk Agent Platform - Development Environment (Laptop)
# ============================================================

# Este archivo contiene variables para desarrollo local.
# Copiar a .env y ajustar según necesidad.

# ========== VPS Services (Docker local) ==========
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://kiosk:kiosk_dev_password@localhost:5432/kiosk

# ========== Orchestrator ==========
ORCHESTRATOR_URL=ws://localhost:8765/ws
ORCHESTRATOR_PORT=8765

# ========== Speech Service (F3) ==========
SPEECH_SERVICE_URL=http://localhost:9001

# ========== Vision Service (F1) ==========
VISION_SERVICE_URL=http://localhost:9003

# ========== MCP Tools (F4) ==========
MCP_TOOLS_URL=http://localhost:9002

# ========== LLM Config ==========
LLM_MODE=mock
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.7
ANTHROPIC_API_KEY=

# ========== External APIs (F3+) ==========
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ========== Kiosk Config ==========
KIOSK_ID=pi-kiosk-dev
LANGUAGE=es

# ========== Debug ==========
LOG_LEVEL=DEBUG
DEBUG_MODE=true
DEBUG_SAVE_AUDIO=false
