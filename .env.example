# AI Kiosk Agent Platform - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# Speech Service Configuration
# ============================================================

# Mode selection: local (free) or premium (API-based)
SPEECH_ASR_MODE=local          # local | deepgram
SPEECH_TTS_MODE=local          # local | elevenlabs

# Local ASR (faster-whisper) - FREE
SPEECH_WHISPER_MODEL_SIZE=small  # tiny | base | small | medium | large-v2
SPEECH_WHISPER_DEVICE=auto       # auto | cpu | cuda
SPEECH_WHISPER_COMPUTE_TYPE=auto # auto | int8 | float16 | float32

# Local TTS (Piper) - FREE
# Model path is set automatically in Docker
# SPEECH_PIPER_MODEL_PATH=/models/es_ES-sharvard-medium.onnx

# TTS Cache (reduces latency for common phrases)
SPEECH_TTS_CACHE_ENABLED=true
SPEECH_TTS_CACHE_PRELOAD=true

# Fallback to local if API fails
SPEECH_ENABLE_FALLBACK=true

# ============================================================
# Premium APIs (optional - only if using deepgram/elevenlabs)
# ============================================================

# Deepgram ASR API (if SPEECH_ASR_MODE=deepgram)
# SPEECH_DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs TTS API (if SPEECH_TTS_MODE=elevenlabs)
# SPEECH_ELEVENLABS_API_KEY=your_elevenlabs_api_key
# SPEECH_TTS_VOICE_ID=your_voice_id

# ============================================================
# Other Services
# ============================================================

# Kiosk configuration
KIOSK_ID=pi-kiosk-dev
KIOSK_LANGUAGE=es

# Backend WebSocket connection
VITE_BACKEND_WS_URL=ws://localhost:8765/ws
VITE_KIOSK_ID=pi-kiosk-dev
