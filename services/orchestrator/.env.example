# Service Discovery
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://kiosk:kiosk_dev_password@localhost:5432/kiosk

# Service URLs
SPEECH_SERVICE_URL=http://localhost:9001
VISION_SERVICE_URL=http://localhost:9003
MCP_TOOLS_URL=http://localhost:9002

# ============================================================
# LLM Config (REQUIRED — configure at least one API key)
# ============================================================
# Modes: gemini | grok | anthropic | mock
LLM_MODE=mock
LLM_MODEL=                    # Optional, uses defaults per provider
LLM_TEMPERATURE=0.3

# API Keys — you only need ONE depending on LLM_MODE
#
# RECOMMENDED for development (FREE):
# Gemini - https://aistudio.google.com
GEMINI_API_KEY=
#
# Alternative (FREE with limits):
# Grok - https://console.x.ai
GROK_API_KEY=
#
# Alternative (paid):
# Anthropic - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Security
ALLOWED_KIOSK_IDS=pi-kiosk-dev,pi-kiosk-001
API_KEYS=demo_local_api_key

# Observability
LOG_LEVEL=INFO
DEBUG_SAVE_AUDIO=false

# Server
HOST=0.0.0.0
PORT=8765
